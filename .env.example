# ===== ฐานข้อมูล Supabase (PostgreSQL) =====
# DATABASE_URL ใช้ connection pooler (พอร์ต 6543) + pgbouncer=true สำหรับ runtime
# DIRECT_URL ใช้ direct connection (พอร์ต 5432) สำหรับ prisma migrate / db push
DATABASE_URL="postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ===== ระบบผู้ดูแล (Admin) =====
# รหัสผ่านสำหรับเข้าหน้า /admin — ตั้งให้เดายาก
ADMIN_PASSWORD="เปลี่ยนรหัสนี้ให้ปลอดภัย"
# คีย์ลับสำหรับเซ็น cookie session — สุ่มยาว ๆ (เช่น `openssl rand -hex 32`)
AUTH_SECRET="สุ่มสตริงยาวอย่างน้อย-32-ตัวอักษร"

# ===== เว็บไซต์ =====
# URL จริงของเว็บ (ใช้กับ sitemap / SEO / Open Graph)
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"

# ===== Supabase Storage (อัปโหลดรูป) =====
SUPABASE_URL="https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key-จาก-supabase"
SUPABASE_STORAGE_BUCKET="uploads"
